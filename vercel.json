{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://jalsetu-mvp.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://jalsetu-mvp.onrender.com/uploads/$1"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard"
    },
    {
      "source": "/portal/(.*)",
      "destination": "/portal"
    }
  ]
}
