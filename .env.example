# =========================================================================
# Jal Setu — Environment Configuration Template
# Copy this file to `.env` for local development or set in your cloud dashboard.
# NEVER commit your actual `.env` file to version control.
# =========================================================================

# --- Server & Port Configuration ---
PORT=8000
ENVIRONMENT=production

# --- Security & Secret Key ---
# Required in production: Generate a secure 32+ character random string
# Example on Linux/macOS: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# --- Database Configuration (Managed PostgreSQL / PostGIS) ---
# For permanent cloud deployment, use a managed PostgreSQL instance with PostGIS support.
# If omitted or left empty, Jal Setu automatically falls back to local SQLite (parjanya.db).
# Example: postgresql://username:password@hostname:5432/jalsetu_db
DATABASE_URL=sqlite:///backend/parjanya.db

# Database Connection Pool Settings (Optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Host and Origin Security (CORS & Trusted Hosts) ---
# Comma-separated list of allowed host headers (or * for all)
ALLOWED_HOSTS=*

# Comma-separated list of allowed CORS origins for browser security
# In production, set to your exact public domain(s), e.g.:
# ALLOWED_ORIGINS=https://jalsetu.onrender.com
ALLOWED_ORIGINS=*

# --- Public URL ---
# The public HTTPS URL where this service is reachable
PUBLIC_BASE_URL=https://jalsetu.onrender.com

# --- AI Chatbot Configuration ("Ask Jal Setu") ---
# Options: 'ollama' (local default) or 'openai' (hosted OpenAI-compatible)
LLM_PROVIDER=ollama

# API key for hosted LLM providers (required if LLM_PROVIDER=openai)
# Leave empty if using local Ollama or rule-based fallback
LLM_API_KEY=

# Ollama local configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hosted OpenAI configuration (if LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Storage Configuration ---
# Directory where geo-tagged field photographs are stored
# In production, mount a persistent volume disk at this path
UPLOAD_DIR=uploads/evidence
